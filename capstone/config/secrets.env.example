# Copy to config/secrets.env and fill in. config/secrets.env is git-ignored - never commit it.
# Share the real file with students privately (not via GitHub).

# Way 2 sign-in (service principal) - used by ./scripts/login.sh sp
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=paste-the-secret-here
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Cloudflare token (Zone > DNS > Edit on your zone only) - used by deploy/destroy
CLOUDFLARE_API_TOKEN=paste-the-token-here

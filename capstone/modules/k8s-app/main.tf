# k8s-app module: the 3-tier application, inside the cluster.
#
#   frontend (nginx)  -->  backend (Flask API)  -->  database (PostgreSQL on an Azure Disk)
#        ^
#        |  Service type LoadBalancer, *internal* (private IP) - the Application Gateway calls it
#
# No managed database service is used - PostgreSQL runs as a StatefulSet in the cluster.

terraform {
  required_providers {
    kubernetes = {
      source = "hashicorp/kubernetes"
    }
  }
}

locals {
  ns = "capstone"
}

resource "kubernetes_namespace_v1" "this" {
  metadata {
    name = local.ns
  }
}

# ---------------------------------------------------------------- database ---
resource "kubernetes_secret_v1" "db" {
  metadata {
    name      = "db-credentials"
    namespace = kubernetes_namespace_v1.this.metadata[0].name
  }
  data = {
    password = var.db_password # generated by Terraform, also stored in Key Vault
  }
}

resource "kubernetes_stateful_set_v1" "postgres" {
  metadata {
    name      = "postgres"
    namespace = kubernetes_namespace_v1.this.metadata[0].name
    labels    = { app = "postgres" }
  }

  spec {
    service_name = "postgres"
    replicas     = 1

    selector {
      match_labels = { app = "postgres" }
    }

    template {
      metadata {
        labels = { app = "postgres" }
      }
      spec {
        container {
          name  = "postgres"
          image = "${var.registry}/${var.postgres_image}"

          port {
            container_port = 5432
          }
          env {
            name  = "POSTGRES_DB"
            value = var.db_name
          }
          env {
            name  = "POSTGRES_USER"
            value = var.db_user
          }
          env {
            name = "POSTGRES_PASSWORD"
            value_from {
              secret_key_ref {
                name = kubernetes_secret_v1.db.metadata[0].name
                key  = "password"
              }
            }
          }
          env {
            name  = "PGDATA"
            value = "/var/lib/postgresql/data/pgdata"
          }
          volume_mount {
            name       = "data"
            mount_path = "/var/lib/postgresql/data"
          }
          resources {
            requests = { cpu = "100m", memory = "256Mi" }
            limits   = { memory = "512Mi" }
          }
          readiness_probe {
            exec {
              command = ["pg_isready", "-U", var.db_user, "-d", var.db_name]
            }
            initial_delay_seconds = 10
            period_seconds        = 5
          }
        }
      }
    }

    # The data lives on an Azure Disk (built-in "managed-csi" storage class).
    volume_claim_template {
      metadata {
        name = "data"
      }
      spec {
        access_modes       = ["ReadWriteOnce"]
        storage_class_name = "managed-csi"
        resources {
          requests = { storage = "5Gi" }
        }
      }
    }
  }
}

resource "kubernetes_service_v1" "postgres" {
  metadata {
    name      = "postgres"
    namespace = kubernetes_namespace_v1.this.metadata[0].name
  }
  spec {
    selector = { app = "postgres" }
    port {
      port        = 5432
      target_port = 5432
    }
  }
}

# ----------------------------------------------------------------- backend ---
resource "kubernetes_service_account_v1" "backend" {
  metadata {
    name      = "backend"
    namespace = kubernetes_namespace_v1.this.metadata[0].name
    annotations = {
      # Links this Kubernetes service account to the Entra ID identity.
      "azure.workload.identity/client-id" = var.workload_identity_client_id
    }
  }
}

resource "kubernetes_deployment_v1" "backend" {
  metadata {
    name      = "backend"
    namespace = kubernetes_namespace_v1.this.metadata[0].name
    labels    = { app = "backend" }
  }

  spec {
    replicas = 1
    selector {
      match_labels = { app = "backend" }
    }

    template {
      metadata {
        labels = {
          app = "backend"
          # Tells the workload-identity webhook to inject the Entra ID token.
          "azure.workload.identity/use" = "true"
        }
      }
      spec {
        service_account_name = kubernetes_service_account_v1.backend.metadata[0].name

        container {
          name              = "backend"
          image             = "${var.registry}/capstone-backend:${var.image_tag}"
          image_pull_policy = "IfNotPresent"

          port {
            container_port = 8080
          }
          env {
            name  = "STUDENT_ID"
            value = var.student_id
          }
          env {
            name  = "DB_HOST"
            value = kubernetes_service_v1.postgres.metadata[0].name
          }
          env {
            name  = "DB_NAME"
            value = var.db_name
          }
          env {
            name  = "DB_USER"
            value = var.db_user
          }
          env {
            name = "DB_PASSWORD"
            value_from {
              secret_key_ref {
                name = kubernetes_secret_v1.db.metadata[0].name
                key  = "password"
              }
            }
          }
          env {
            name  = "KEYVAULT_URL"
            value = var.key_vault_uri
          }
          env {
            name  = "BANNER_SECRET_NAME"
            value = "app-banner"
          }
          resources {
            requests = { cpu = "100m", memory = "128Mi" }
            limits   = { memory = "256Mi" }
          }
          readiness_probe {
            http_get {
              path = "/api/health"
              port = 8080
            }
            initial_delay_seconds = 5
            period_seconds        = 5
          }
        }
      }
    }
  }

  depends_on = [kubernetes_stateful_set_v1.postgres]
}

resource "kubernetes_service_v1" "backend" {
  metadata {
    name      = "backend"
    namespace = kubernetes_namespace_v1.this.metadata[0].name
  }
  spec {
    selector = { app = "backend" }
    port {
      port        = 8080
      target_port = 8080
    }
  }
}

# ---------------------------------------------------------------- frontend ---
resource "kubernetes_deployment_v1" "frontend" {
  metadata {
    name      = "frontend"
    namespace = kubernetes_namespace_v1.this.metadata[0].name
    labels    = { app = "frontend" }
  }

  spec {
    replicas = 1
    selector {
      match_labels = { app = "frontend" }
    }

    template {
      metadata {
        labels = { app = "frontend" }
      }
      spec {
        container {
          name              = "frontend"
          image             = "${var.registry}/capstone-frontend:${var.image_tag}"
          image_pull_policy = "IfNotPresent"

          port {
            container_port = 80
          }
          resources {
            requests = { cpu = "50m", memory = "32Mi" }
            limits   = { memory = "128Mi" }
          }
          readiness_probe {
            http_get {
              path = "/healthz"
              port = 80
            }
            initial_delay_seconds = 3
            period_seconds        = 5
          }
        }
      }
    }
  }

  # nginx looks up the "backend" name when it starts, so the Service must exist first.
  depends_on = [kubernetes_service_v1.backend]
}

# Internal Azure Load Balancer with a fixed private IP. Only the Application
# Gateway (inside the same VNet) can reach it.
resource "kubernetes_service_v1" "frontend" {
  metadata {
    name      = "frontend"
    namespace = kubernetes_namespace_v1.this.metadata[0].name
    annotations = {
      "service.beta.kubernetes.io/azure-load-balancer-internal" = "true"
      "service.beta.kubernetes.io/azure-load-balancer-ipv4"     = var.internal_lb_ip
    }
  }
  spec {
    type     = "LoadBalancer"
    selector = { app = "frontend" }
    port {
      port        = 80
      target_port = 80
    }
  }
  wait_for_load_balancer = true
}
